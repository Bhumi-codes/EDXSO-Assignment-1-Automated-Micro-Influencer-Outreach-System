# Copy to .env locally; fill real values privately. Never commit .env.
# Stage entry points load this project-local file via python-dotenv.
# Existing process environment variables override this file (even empty values).
YOUTUBE_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# Existing YouTube config defaults. Do not change filtering policy during cleanup.
DISCOVERY_TARGET=50
RECENT_VIDEO_LIMIT=10
MIN_SUBSCRIBERS=5000
MAX_SUBSCRIBERS=100000
MAX_SEARCH_REQUESTS=12
MAX_PLAYLIST_PAGES_PER_CHANNEL=3
REQUEST_TIMEOUT_SECONDS=30

# Optional existing setting: pipe-separated queries; leave unset to use defaults.
# YOUTUBE_SEARCH_QUERIES=Python programming and development|machine learning with Python

# Gmail uses local credentials.json and generated token.json, not an API key.
# Supply your own test address explicitly via --test-recipient; none is hardcoded.
# All stages use this same path. Relative values are relative to the project.
DATABASE_PATH=data/outreach.db
